# winning-product-curator - copy to .env and fill in. Quote values that contain spaces.
# .env is loaded by every script and by the weekly runner. It must NEVER contain the Shopify WRITE token
# (that lives in .env.apply, see .env.apply.example, and is only read by apply_approved_plan.py).

# --- Store / schedule -------------------------------------------------------------------------
# IANA zone of the store; the weekly run fires Thursday 04:00 in this zone (cron "0 4 * * 4").
STORE_TIMEZONE=America/New_York

# --- Shopify Admin API (READ-ONLY custom app token) ---------------------------------------------
# Shopify admin > Settings > Apps and sales channels > Develop apps > create "curator-readonly" with ONLY:
#   read_products, read_inventory, read_orders, read_online_store_navigation (optional: read_all_orders for >60 days)
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_READ_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-07
# Sub-collection conventions (defaults shown)
SUBCOLLECTION_PARENT_METAFIELD=custom.parent_collection
NAVIGATION_MENU_HANDLE=main-menu
EXCLUDED_COLLECTION_HANDLES=frontpage,all
# Optional: force the list of primary collections instead of deriving it from menus/metafields
PRIMARY_COLLECTION_HANDLES=
SHOPIFY_PRODUCT_PAGE_SIZE=6

# --- WinningHunter (one key for REST + MCP; Basic plan for API, Standard for Meta ads) ----------
# Create at https://app.winninghunter.com/api . REST limit 60/min, MCP 300/min per account.
WH_API_KEY=wh_xxxxxxxxxxxxxxxxxxxxxxxx
WH_API_ORIGIN=https://app.winninghunter.com

# --- CJdropshipping API 2.0 (cjdropshipping.us, US warehouses) ---------------------------------
# CJ dashboard > Authorization > API > generate API key. Token is cached in .wpc/cj_token.json (0600).
CJ_API_KEY=
CJ_EMAIL=

# --- AliExpress Open Platform dropshipping API (optional; DSers MCP quotes are the default path) --
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=

# --- DSers & AutoDS MCP servers ---------------------------------------------------------------
# Paste the MCP server URL from your DSers / AutoDS account (MCP / AI integrations page), then run
# `/mcp` in Claude Code once to complete OAuth. If you use them as claude.ai connectors instead,
# leave these empty and remove the servers from .mcp.json.
DSERS_MCP_URL=
AUTODS_MCP_URL=

# --- Notifications when the weekly Change Plan is ready ---------------------------------------
# Any of: slack, ntfy, email, desktop, stdout
NOTIFY_CHANNELS=desktop
SLACK_WEBHOOK_URL=
NTFY_TOPIC_URL=
NTFY_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# --- Runner ------------------------------------------------------------------------------------
# CLAUDE_BIN=/usr/local/bin/claude
# PYTHON_BIN=python3
# WPC_RUN_TIMEOUT=14400
# WPC_LOG_LEVEL=INFO
